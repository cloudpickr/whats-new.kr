# Public site origin — the single source of truth for every domain reference
# (canonical URLs, sitemap, OG, and the derived API host api.<host>). In prod
# this is a SERVICE VARIABLE, not a file: a GitHub Actions repo variable
# (gh variable set SITE_URL) that deploy.yml passes to the Astro build, and
# wrangler.toml [vars].SITE_URL for the Worker runtime. The literal below is
# only for local dev / as a safety fallback.
SITE_URL=https://whats-new.kr
BACKLOG_QUEUE_BATCH_SIZE=25
AUTH_ENFORCEMENT=on
TRUSTED_IP_BYPASS=on

# GET /api/articles website-only gate: 'warn' logs but still serves (default,
# used during rollout), 'on' returns 401 without a valid 'site' token, 'off' disables.
SITE_API_ENFORCEMENT=warn

# Optional: Slack or Discord webhook for ingestion alerts
ALERT_WEBHOOK_URL=

# Optional: comma-separated admin IP allowlist for write endpoints
ALLOWED_ADMIN_IPS=

# Optional: daily cap for the fluent-Korean refresh pass (re-polishing cards
# that ALREADY passed translation + AI review). Defaults to 100 when unset —
# leave it out to keep current behavior. Lower it only to throttle Workers AI
# Neuron spikes; it never affects new-article translation or the AI quality
# review, so lowering it does not reduce card quality (only how fast already-
# good cards get further improved). Range 0–500.
FLUENT_REFRESH_DAILY_CAP=

# Optional: override the translation / review model IDs at runtime (no redeploy).
# Defaults keep @cf/zai-org/glm-4.7-flash (translation) and
# @cf/meta/llama-3.1-8b-instruct-fp8 (review) when unset. The biweekly
# model-eval workflow (.github/workflows/model-eval.yml) reports candidates
# scored against the fluent-korean guideline + Neuron cost; a human sets these
# after reviewing. Must be valid Workers AI text-generation model IDs (@cf/...).
TRANSLATION_MODEL=
REVIEW_MODEL=

# Required in production: JSON array of bearer tokens for admin/MCP/site access
# Types: "service" (admin API), "mcp" (POST /mcp), "site" (GET /api/articles,
# used by this project's own Astro SSR — see SITE_API_TOKEN below)
API_KEY_RING=[]

# Pages-side secret (wrangler pages secret put SITE_API_TOKEN), same value as
# the "site"-type entry in API_KEY_RING above. Sent by Astro SSR to /api/articles.
SITE_API_TOKEN=
