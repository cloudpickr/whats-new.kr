---
import '../styles/base.css';
import '../styles/themes.css';
import '../styles/components.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  vendor?: string;
  ogImage?: string;
  ogImageAlt?: string;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description = 'Amazon Web Services, Google Cloud, Microsoft Azure 클라우드 최신 업데이트를 한국어로 요약합니다.',
  vendor = 'home',
  ogImage = '/og.png',
  ogImageAlt = 'What\'s New 한국어 요약 공유 이미지',
  structuredData = [],
} = Astro.props;
const cspNames: Record<string, string> = { home: 'Cloud What\'s New', aws: 'AWS', gcp: 'GCP', azure: 'Azure' };
const siteName = 'What\'s New 한국어 요약';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(ogImage, Astro.site).toString();
const structuredDataItems = Array.isArray(structuredData) ? structuredData : [structuredData];
// Per-vendor brand font to preload (regular weight only — the LCP text face)
const fontPreload: Record<string, string> = {
  aws: '/fonts/amazon-ember-400.woff2',
  azure: 'https://c.s-microsoft.com/static/fonts/segoe-ui/west-european/Normal/latest.woff2',
};
---

<!DOCTYPE html>
<html lang="ko" data-vendor={vendor}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Critical above-the-fold CSS: paint header+body immediately -->
    <style is:inline set:html={`
      /* Critical above-the-fold: paint header+body immediately */
      :root {
        --nav-height: ${vendor === 'azure' ? '48px' : vendor === 'gcp' ? '64px' : '56px'};
        --color-bg: ${vendor === 'aws' ? '#F2F3F3' : vendor === 'gcp' ? '#F8F9FA' : vendor === 'azure' ? '#FAF9F8' : '#F9FAFB'};
        --color-text-primary: ${vendor === 'aws' ? '#000716' : vendor === 'gcp' ? '#202124' : vendor === 'azure' ? '#242424' : '#101828'};
        --nav-bg: ${vendor === 'aws' || vendor === 'home' ? '#232F3E' : vendor === 'gcp' ? '#FFFFFF' : '#FFFFFF'};
        --color-border: ${vendor === 'aws' ? '#D5DBDB' : vendor === 'gcp' ? 'transparent' : vendor === 'azure' ? '#EDEBE9' : '#E4E7EC'};
      }
      [data-theme="dark"] {
        --color-bg: ${vendor === 'aws' ? '#16191f' : vendor === 'gcp' ? '#202124' : vendor === 'azure' ? '#1B1A19' : '#0F1117'};
        --color-text-primary: ${vendor === 'aws' ? '#eaeded' : vendor === 'gcp' ? '#E8EAED' : vendor === 'azure' ? '#F3F2F1' : '#F4F4F6'};
        --nav-bg: ${vendor === 'aws' ? '#16191f' : vendor === 'gcp' ? '#292A2D' : vendor === 'azure' ? '#292827' : '#0F1117'};
        --color-border: ${vendor === 'aws' ? '#303846' : vendor === 'gcp' ? 'transparent' : vendor === 'azure' ? '#3B3A39' : '#2D3148'};
      }
      body { background-color: var(--color-bg); color: var(--color-text-primary); margin: 0; }
      body.no-transition { transition: none !important; }
      header { position: sticky; top: 0; z-index: 50; height: var(--nav-height); min-height: var(--nav-height); background-color: var(--nav-bg); border-bottom: 1px solid var(--color-border); }
    `} />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://c.s-microsoft.com" crossorigin>
    {fontPreload[vendor] && <link rel="preload" as="font" type="font/woff2" href={fontPreload[vendor]} crossorigin />}
    <!-- Google Sans (GCP brand face) — non-blocking; was a render-blocking @import chain -->
    <link href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;700&display=swap" media="print" onload="this.media='all'" rel="stylesheet">
    <!-- Pretendard: single Korean face for every vendor stack (Noto Sans KR dropped — two Hangul fonts were loaded) -->
    <link rel="preload" as="style" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" onload="this.onload=null;this.rel='stylesheet'">
    <noscript>
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;700&display=swap">
    </noscript>
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={vendor === 'aws' ? '#232F3E' : vendor === 'gcp' ? '#1A73E8' : vendor === 'azure' ? '#0078D4' : '#0F172A'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonicalUrl} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:locale" content="ko_KR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {structuredDataItems.filter(Boolean).map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.addEventListener('load', () => {
        const script = document.createElement('script');
        script.src = 'https://www.googletagmanager.com/gtag/js?id=G-RQRGQJ1WQR';
        script.async = true;
        script.onload = () => {
          gtag('js', new Date());
          gtag('config', 'G-RQRGQJ1WQR', { send_page_view: false });
          gtag('event', 'page_view', {
            page_title: document.title,
            page_location: location.href,
            page_path: location.pathname,
          });
          window.__gaReady = true;
        };
        document.head.appendChild(script);
      });
      document.addEventListener('astro:page-load', () => {
        if (!window.__gaReady) return;
        gtag('event', 'page_view', {
          page_title: document.title,
          page_location: location.href,
          page_path: location.pathname,
        });
      });
    </script>
    <script is:inline>
      (function () {
        function isDark() {
          const stored = localStorage.getItem('theme');
          if (stored === 'dark') return true;
          if (stored === 'light') return false;
          return window.matchMedia('(prefers-color-scheme: dark)').matches;
        }
        function applyTheme(root) {
          if (isDark()) root.setAttribute('data-theme', 'dark');
          else root.removeAttribute('data-theme');
        }
        applyTheme(document.documentElement);
        document.addEventListener('astro:before-swap', (event) => {
          applyTheme(event.newDocument.documentElement);
        });
      })();
    </script>
    <ClientRouter />
  </head>
  <body class="no-transition">
    <header>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-full flex justify-between items-center">
        <a href="/" class="text-base sm:text-lg font-bold" style="color: var(--nav-brand-color);">
          ☁️ What's New <span class="hidden sm:inline">한국어 요약</span> <span class="text-[10px] sm:text-xs font-normal opacity-50"><span class="sm:hidden">β</span><span class="hidden sm:inline">Beta</span></span>
        </a>
        <nav class="flex items-center h-full gap-0.5 sm:gap-1.5">
          {(['aws', 'gcp', 'azure'] as const).map(c => (
            <a href={`/${c}`} class={`nav-item${vendor === c ? ' is-active' : ''}`} aria-current={vendor === c ? 'page' : undefined}>
              {cspNames[c]}
            </a>
          ))}
          <button id="theme-toggle" type="button" aria-label="다크 모드 전환" aria-pressed="false" class="ml-2 p-1.5 rounded transition-colors" style="color: var(--nav-item-color);">
            <svg id="icon-dark" class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg>
            <svg id="icon-light" class="hidden w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"></path></svg>
          </button>
        </nav>
      </div>
    </header>
    <main class="page-main">
      <slot />
    </main>
    <footer style="background-color: var(--color-surface); border-top: 1px solid var(--color-border);" class="mt-8">
      <div class="max-w-7xl mx-auto py-4 px-4 text-center text-xs" style="color: var(--color-text-secondary);">
        © {new Date().getFullYear()} Cloud ☁️ What's New <span class="hidden sm:inline">한국어 요약</span> <span class="text-[10px] sm:text-xs font-normal opacity-50"><span class="sm:hidden">β</span><span class="hidden sm:inline">Beta</span></span>. Not affiliated with Amazon Web Services, Google Cloud, or Microsoft Azure.
      </div>
    </footer>
    <script>
      function initThemeToggle() {
        const html = document.documentElement;
        const toggle = document.getElementById('theme-toggle');
        const iconDark = document.getElementById('icon-dark');
        const iconLight = document.getElementById('icon-light');
        if (!toggle || !iconDark || !iconLight) return;

        function updateIcons(el: HTMLElement, dk: HTMLElement, lt: HTMLElement) {
          const dark = html.getAttribute('data-theme') === 'dark';
          dk.classList.toggle('hidden', dark);
          lt.classList.toggle('hidden', !dark);
          el.setAttribute('aria-pressed', dark ? 'true' : 'false');
        }

        updateIcons(toggle, iconDark, iconLight);

        toggle.onclick = () => {
          document.body.style.transition = 'background-color 0.2s, color 0.2s';
          const nextDark = html.getAttribute('data-theme') !== 'dark';
          if (nextDark) html.setAttribute('data-theme', 'dark');
          else html.removeAttribute('data-theme');
          localStorage.setItem('theme', nextDark ? 'dark' : 'light');
          updateIcons(toggle, iconDark, iconLight);
        };
      }

      document.addEventListener('astro:page-load', initThemeToggle);
    </script>
    <script is:inline>
      // Enable transitions after first paint (double-rAF ensures paint is complete)
      requestAnimationFrame(function(){requestAnimationFrame(function(){document.body.classList.remove('no-transition')})});
    </script>
  </body>
</html>
