---
import Layout from '../layouts/Layout.astro';
import UpdateCard from '../components/UpdateCard.astro';
import { apiBase, apiHeaders } from '../lib/apiClient';

const { csp } = Astro.params;
const valid = ['aws', 'gcp', 'azure'];
if (!csp || !valid.includes(csp)) return Astro.redirect('/');

const siteUrl = Astro.site ?? new URL('https://whats-new.kr');
const API_BASE = apiBase(siteUrl);

let articles: any[] = [];
try {
  const res = await fetch(`${API_BASE}/api/articles?csp=${csp}&lang=ko&limit=80`, { headers: apiHeaders(Astro.locals) });
  articles = (await res.json()).items || [];
} catch (e) { console.error(e); }

const rssLinks: Record<string, { name: string; url: string }> = {
  aws: { name: 'AWS What\'s New', url: 'https://aws.amazon.com/new/' },
  gcp: { name: 'Google Cloud Release Notes', url: 'https://cloud.google.com/release-notes' },
  azure: { name: 'Azure Updates', url: 'https://azure.microsoft.com/en-us/updates/' },
};
const names: Record<string, string> = { aws: 'Amazon Web Services', gcp: 'Google Cloud', azure: 'Microsoft Azure' };
const rss = rssLinks[csp];
const latest = articles[0]?.pub_date ? new Date(articles[0].pub_date).toLocaleString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : '';

// Status counting
const STATUS_ORDER = ['정식 출시', '미리보기', '베타', '지원 종료'];
const statusCounts: Record<string, number> = {};
for (const a of articles) {
  if (a.is_fallback) {
    statusCounts['번역 준비중'] = (statusCounts['번역 준비중'] || 0) + 1;
  } else {
    try {
      const ss = JSON.parse(a.status || '[]');
      const arr: string[] = Array.isArray(ss) ? ss : [];
      for (const s of arr) {
        if (STATUS_ORDER.includes(s)) statusCounts[s] = (statusCounts[s] || 0) + 1;
      }
    } catch { /* ignore */ }
  }
}

function getArticleStatuses(a: any): string {
  if (a.is_fallback) return '번역 준비중';
  try {
    const ss = JSON.parse(a.status || '[]');
    return Array.isArray(ss) ? ss.join(',') : '';
  } catch { return ''; }
}

const filterClass: Record<string, string> = { '정식 출시': 'ga', '미리보기': 'preview', '베타': 'beta', '지원 종료': 'retired', '번역 준비중': 'fallback' };
const activeStatusFilters = [...STATUS_ORDER.filter(s => (statusCounts[s] || 0) > 0), ...(statusCounts['번역 준비중'] ? ['번역 준비중'] : [])];
const categoryUrl = new URL(`/${csp}`, Astro.site).toString();
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${names[csp]} 업데이트 | What's New 한국어 요약`,
    url: categoryUrl,
    inLanguage: 'ko-KR',
    description: `${names[csp]} 공식 업데이트를 한국어로 요약한 최신 릴리스 노트 목록입니다.`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'What\'s New 한국어 요약',
        item: new URL('/', Astro.site).toString(),
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: names[csp],
        item: categoryUrl,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `${names[csp]} 최신 업데이트`,
    itemListElement: articles.slice(0, 10).map((a, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: a.title,
      url: a.url,
      datePublished: a.pub_date,
    })),
  },
];

---

<Layout
  title={`${names[csp]} 업데이트 | What's New 한국어 요약`}
  description={`${names[csp]} 공식 업데이트를 빠르게 훑어볼 수 있도록 한국어로 정리한 최신 릴리스 노트 목록입니다.`}
  vendor={csp}
  ogImageAlt={`${names[csp]} 공식 업데이트를 한국어로 요약한 What's New 한국어 요약 공유 이미지`}
  structuredData={structuredData}
>
  <div class="page-head">
    <div class="page-head__text">
      <h1 class="page-head__title">
        <span class="page-head__dot" aria-hidden="true"></span>
        {names[csp]} 업데이트<span class="page-head__counter">({articles.length})</span>
      </h1>
      <p class="page-head__desc">
        {names[csp]} <a href={rss.url} target="_blank" rel="noopener noreferrer" class="underline font-semibold hover:opacity-80" style="color: var(--color-primary);">공식 RSS 피드</a>를 실시간 기계번역 및 품질 필터링을 통해 전달합니다.
      </p>
      {latest && <span class="page-head__meta">최종 업데이트: {latest}</span>}
    </div>
    <div class="page-head__tools">
      {activeStatusFilters.length > 0 && (
        <div class="page-head__filters" id="filter-bar">
          {activeStatusFilters.map(s => (
            <button
              class={`filter-btn filter-btn--${filterClass[s]}`}
              type="button"
              aria-pressed="false"
              data-filter={s}>
              {s}<span class="count">{statusCounts[s]}</span>
            </button>
          ))}
        </div>
      )}
      <div class="page-head__search search">
        <svg class="search__icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <input type="search" id="search" placeholder="검색..." aria-label="업데이트 검색" autocomplete="off" class="search__input" />
      </div>
    </div>
  </div>

  <div class="cards-grid" id="cards">
    {articles.map((a, i) => (
      <div class="card-wrapper" data-statuses={getArticleStatuses(a)}>
        <UpdateCard
          title={a.title} csp={a.csp} index={i}
          date={a.pub_date ? new Date(a.pub_date).toLocaleDateString('ko-KR', { year: 'numeric', month: 'short', day: 'numeric' }) : ''}
          content={a.summary || ''} target={a.target} features={a.features}
          regions={a.regions} status={a.status} originalLink={a.url} isFallback={!!a.is_fallback} articleId={a.article_id} />
      </div>
    ))}
  </div>

  {articles.length === 0 && (
    <p class="text-center py-16 text-sm" style="color: var(--color-text-secondary);">업데이트가 없습니다.</p>
  )}

  <p id="no-results" class="hidden text-center py-16 text-sm" style="color: var(--color-text-secondary);">검색 결과가 없습니다.</p>

  <script>
    // Bind search and filtering on page load/navigation
    function initSearchFilters() {
      const searchEl = document.getElementById('search') as HTMLInputElement;
      const wrappers = Array.from(document.querySelectorAll<HTMLElement>('#cards > .card-wrapper'));
      const noResults = document.getElementById('no-results') as HTMLElement;
      let activeFilter = '';

      function applyFilters() {
        const q = (searchEl?.value || '').toLowerCase();
        let visible = 0;
        wrappers.forEach(wrapper => {
          const matchSearch = !q || (wrapper.textContent?.toLowerCase() || '').includes(q);
          const matchFilter = !activeFilter || (wrapper.dataset.statuses || '').includes(activeFilter);
          const show = matchSearch && matchFilter;
          wrapper.style.display = show ? '' : 'none';
          if (show) visible++;
        });
        if (noResults) noResults.classList.toggle('hidden', visible > 0);
      }

      searchEl?.addEventListener('input', applyFilters);

      document.querySelectorAll<HTMLElement>('.filter-btn').forEach(btn => {
        btn.onclick = () => {
          const f = btn.dataset.filter || '';
          activeFilter = activeFilter === f ? '' : f;
          document.querySelectorAll<HTMLElement>('.filter-btn').forEach(b => {
            b.classList.toggle('is-active', b.dataset.filter === activeFilter && activeFilter !== '');
            b.setAttribute('aria-pressed', b.dataset.filter === activeFilter && activeFilter !== '' ? 'true' : 'false');
          });
          applyFilters();
        };
      });
    }

    document.addEventListener('astro:page-load', initSearchFilters);
  </script>

</Layout>

<script>
  // Pulse on arrival + persistent card-active (hover-like) state
  function initCardActiveState() {
    let activeCard: HTMLElement | null = null;

    function expandTarget() {
      const hash = window.location.hash;
      if (!hash) return;

      // Deactivate previous
      if (activeCard) activeCard.classList.remove('card-active');

      const card = document.querySelector<HTMLElement>(hash);
      if (!card) return;
      activeCard = card;

      // Persist hover-like state
      card.classList.add('card-active');

      // Amber pulse for initial attention
      card.classList.remove('card-pulse');
      void card.offsetWidth;
      card.classList.add('card-pulse');

      setTimeout(() => card.scrollIntoView({ behavior: 'smooth', block: 'center' }), 100);
    }

    // Click outside to dismiss active state
    document.onclick = (e) => {
      if (activeCard && !activeCard.contains(e.target as Node)) {
        activeCard.classList.remove('card-active');
        activeCard = null;
      }
    };

    expandTarget();
    window.onhashchange = expandTarget;
  }

  document.addEventListener('astro:page-load', initCardActiveState);
</script>
