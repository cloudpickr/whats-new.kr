---
import Layout from '../layouts/Layout.astro';
import { callBackend } from '../lib/apiClient';

// Edge-cache the rendered HTML at Cloudflare (content refreshes on a 1-min
// cron): 60s edge copy to cut repeat TTFB, 5-min stale-while-revalidate, and
// max-age=0 so browsers always revalidate.
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, s-maxage=60, stale-while-revalidate=300'
);

const csps = [
  { id: 'aws', name: 'Amazon Web Services', color: '#FF9900', accent: '#232F3E', font: "'Amazon Ember', sans-serif" },
  { id: 'gcp', name: 'Google Cloud', color: 'linear-gradient(to right, #4285F4 25%, #EA4335 25%, #EA4335 50%, #FBBC04 50%, #FBBC04 75%, #34A853 75%)', accent: '#4285F4', isGradient: true, font: "'Google Sans', sans-serif", weight: 700 },
  { id: 'azure', name: 'Microsoft Azure', color: '#0078D4', accent: '#50E6FF', font: "'Segoe UI Web', 'Segoe UI', sans-serif" },
  { id: 'oracle', name: 'Oracle Cloud Infrastructure', color: '#C74634', accent: '#C74634', font: "'Oracle Sans', -apple-system, 'Helvetica Neue', 'Segoe UI', Roboto, sans-serif", weight: 600 },
];

const data: Record<string, any[]> = {};
const results = await Promise.all(
  csps.map(c => callBackend<{ items?: any[] }>(`/api/articles?csp=${c.id}&lang=ko&limit=15`, { items: [] }))
);
csps.forEach((c, i) => {
  data[c.id] = results[i].items || [];
});

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'What\'s New 한국어 요약',
    url: Astro.site?.toString(),
    inLanguage: 'ko-KR',
    description: 'AWS, Google Cloud, Microsoft Azure의 최신 업데이트를 한국어로 요약한 클라우드 릴리스 노트 사이트입니다.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: '클라우드 최신 업데이트 | What\'s New 한국어 요약',
    url: new URL('/', Astro.site).toString(),
    inLanguage: 'ko-KR',
    description: 'AWS, Google Cloud, Microsoft Azure의 최신 업데이트를 한국어로 요약해 보여주는 클라우드 릴리스 노트 대시보드입니다.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: '클라우드 공급자 목록',
    itemListElement: csps.map((c, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: c.name,
      url: new URL(`/${c.id}`, Astro.site).toString(),
    })),
  },
];
---

<Layout
  title="클라우드 최신 업데이트 | What's New 한국어 요약"
  description="AWS, Google Cloud, Microsoft Azure의 공식 업데이트를 읽기 쉬운 한국어 카드로 정리한 클라우드 릴리스 노트 대시보드입니다."
  vendor="home"
  ogImageAlt="AWS, Google Cloud, Microsoft Azure 최신 업데이트를 한국어로 요약한 What's New 한국어 요약 공유 이미지"
  structuredData={structuredData}
>
  <!-- Hero with glow background -->
  <div class="hero-band relative text-center py-10 sm:py-20 mb-8 overflow-hidden rounded-3xl" style="background: linear-gradient(135deg, color-mix(in srgb, var(--color-primary) 5%, transparent), color-mix(in srgb, var(--color-accent) 5%, transparent)); border: 1px solid var(--color-border);">
    <div class="absolute -top-24 -left-24 w-48 h-48 rounded-full blur-3xl opacity-20" style="background: var(--color-primary);"></div>
    <div class="absolute -bottom-24 -right-24 w-48 h-48 rounded-full blur-3xl opacity-20" style="background: var(--color-accent);"></div>
    
    <h1 class="text-3xl sm:text-5xl font-black mb-4 tracking-tight" style="color: var(--color-text-primary); font-family: 'Pretendard Variable', var(--font-family);">
      ☁️ What's New <span class="bg-clip-text text-transparent bg-gradient-to-r" style="background-image: linear-gradient(to right, var(--color-primary), var(--color-accent));">한국어 요약</span>
      <span class="text-xs font-semibold px-2 py-0.5 rounded-full ml-1" style="background: color-mix(in srgb, var(--color-primary) 15%, transparent); color: var(--color-primary); vertical-align: middle;">Beta</span>
    </h1>
    <p class="text-sm sm:text-lg max-w-xl mx-auto leading-relaxed" style="color: var(--color-text-secondary); font-family: 'Pretendard Variable', var(--font-family);">
      Amazon Web Services · Google Cloud · Microsoft Azure<br/>
      <span class="font-medium">핵심 클라우드 업데이트만 골라내어 깔끔하게 보여드립니다</span>
    </p>
  </div>

  <!-- Vendor columns: 1 / 2 / 4 across breakpoints (4 CSPs) -->
  <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6 sm:gap-8">
    {csps.map(c => (
      <section class="p-5 rounded-2xl" style="background: var(--color-surface); border: 1px solid var(--color-border); box-shadow: var(--card-shadow);">
        <div class="flex items-center justify-between mb-4 pb-2 border-b-2" style={c.isGradient ? `border-image: ${c.color} 1;` : `border-color: ${c.color};`}>
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full animate-pulse" style={`background: ${c.isGradient ? c.accent : c.color};`}></span>
            <h2 class="text-base sm:text-lg font-extrabold tracking-tight" style={`color: var(--color-text-primary); font-family: ${c.font}; font-weight: ${c.weight || 700};`}>
              {c.name}
            </h2>
          </div>
          <a href={`/${c.id}`} aria-label={`${c.name} 전체 보기`} title={`${c.name} 전체 보기`} class="shrink-0 inline-flex items-center justify-center w-7 h-7 rounded-full text-sm font-bold transition-colors hover:opacity-80" style={`color: ${c.isGradient ? c.accent : c.color}; background: color-mix(in srgb, ${c.isGradient ? c.accent : c.color} 10%, transparent);`}>
            →
          </a>
        </div>
        <ul class="space-y-0">
          {(data[c.id] || []).map((a, i) => (
            <li style={`border-bottom: 1px solid var(--color-border);`}>
              <a href={`/${c.id}#article-${a.article_id}`}
                class="block py-3.5 px-3 no-underline transition-all duration-200 hover:translate-x-1 hover:bg-black/[0.02] dark:hover:bg-white/[0.02] rounded-lg"
                style={`font-family: 'Pretendard Variable', var(--font-family); --item-color: ${c.isGradient ? c.accent : c.color};`}>
                <div class="flex items-start gap-3">
                  <span class="shrink-0 w-1.5 h-1.5 rounded-full mt-2" style={`background: ${c.isGradient ? ['#4285F4','#EA4335','#FBBC04','#34A853'][i % 4] : c.color};`}></span>
                  <div class="min-w-0">
                    <p class="text-sm font-semibold leading-snug mb-1 transition-colors hover:text-[var(--item-color)]" style="color: var(--color-text-primary); word-break: break-word;">
                      {a.title}
                    </p>
                    <time class="text-[11px] font-medium" style="color: var(--color-text-secondary);">
                      {a.pub_date ? new Date(a.pub_date).toLocaleDateString('ko-KR', { month: 'short', day: 'numeric' }) : ''}
                    </time>
                  </div>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Layout>
